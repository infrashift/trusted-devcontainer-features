---
interface Props {
	dependencies: string[];
}

const { dependencies } = Astro.props;
---

{dependencies.length > 0 ? (
	<div class="dependency-chain">
		{dependencies.map((dep, i) => (
			<>
				<a href={`/devcontainer-features/features/${dep}/`} class="dep-link">
					<code>{dep}</code>
				</a>
				{i < dependencies.length - 1 && <span class="arrow"> → </span>}
			</>
		))}
		<span class="arrow"> → </span>
		<span class="current">this feature</span>
	</div>
) : (
	<p>None — this feature is independent and has no dependencies.</p>
)}

<style>
	.dependency-chain {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.25em;
		padding: 0.75em;
		background-color: var(--sl-color-gray-6);
		border-radius: 6px;
	}
	.dep-link {
		text-decoration: none;
		color: var(--sl-color-accent);
	}
	.dep-link:hover {
		text-decoration: underline;
	}
	.arrow {
		color: var(--sl-color-gray-3);
	}
	.current {
		font-style: italic;
		color: var(--sl-color-gray-3);
	}
</style>
