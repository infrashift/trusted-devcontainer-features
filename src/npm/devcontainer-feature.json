// npm-feature/devcontainer-feature.json
// See https://containers.dev/implementors/features/ for the Development Container Feature specification.
{
    "name": "npm-feature",
    "id": "npm",
    "version": "1.8.1",
    "description": "Deprecated: the nodejs feature now replaces its bundled npm itself (option npm_version). Updates npm to a specific version on Red Hat UBI DevContainers.",
    "options": {
        // See available versions at https://github.com/npm/cli/releases
        "target_version": {
            "type": "string",
            "proposals": ["11.9.0", "10.9.2"],
            "default": "12.2.1",
            "description": "Select the npm version to install. npm 12 requires Node ^22.22.2 || ^24.15.0 || >=26; the nodejs feature default satisfies it, but pinning an older 22.x will fail. npm 11.9.0 is the last release on the 11.x line and bundles tar 7.5.7 (GHSA-23hp-3jrh-7fpw). 12.2.1 replaces 12.0.2, whose bundled brace-expansion, http-cache-semantics, ip-address, tar and undici carried 27 published advisories."
        }
    },
    "installsAfter": [
        "./nodejs"
    ],
    "dependsOn": {
        "./bootstrap": {}
    }
}
