// npm-feature/devcontainer-feature.json
// See https://containers.dev/implementors/features/ for the Development Container Feature specification.
{
    "name": "npm-feature",
    "id": "npm",
    "version": "1.5.0",
    "description": "Updates npm to a specific version on Red Hat UBI DevContainers.",
    "options": {
        // See available versions at https://github.com/npm/cli/releases
        "target_version": {
            "type": "string",
            "proposals": ["11.9.0", "10.9.2"],
            "default": "12.0.2",
            "description": "Select the npm version to install. npm 12 requires Node ^22.22.2 || ^24.15.0 || >=26; the nodejs feature default (22.23.2) satisfies it, but pinning an older 22.x will fail. npm 11.9.0 is the last release on the 11.x line and bundles tar 7.5.7 (GHSA-23hp-3jrh-7fpw)."
        }
    },
    "installsAfter": [
        "./nodejs"
    ],
    "dependsOn": {
        "./bootstrap": {}
    }
}
