// ansible-core-feature/devcontainer-feature.json
// See https://containers.dev/implementors/features/ for the Development Container Feature specification.
{
    "name": "ansible-core-feature",
    "id": "ansible-core",
    "version": "1.5.0",
    "description": "Installs ansible-core via UV tool on Red Hat UBI DevContainers.",
    "options": {
        // See available versions at https://pypi.org/project/ansible-core/
        "target_version": {
            "type": "string",
            "proposals": ["2.18.2", "2.17.8"],
            "default": "2.21.3",
            "description": "Select the ansible-core version to install"
        },
        "target_python_version": {
            "type": "string",
            "proposals": ["3.12", "3.13", "3.11"],
            "default": "3.13",
            "description": "Select which Python version to use for the ansible-core venv"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "redhat.ansible",
                "redhat.vscode-yaml",
                "samuelcolvin.jinjahtml"
            ]
        }
    },
    "installsAfter": [
        "./python"
    ],
    "dependsOn": {
        "./bootstrap": {}
    }
}