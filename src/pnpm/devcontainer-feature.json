// pnpm-feature/devcontainer-feature.json
// See https://containers.dev/implementors/features/ for the Development Container Feature specification.
{
    "name": "pnpm-feature",
    "id": "pnpm",
    "version": "1.3.0",
    "description": "Installs pnpm package manager on Red Hat UBI DevContainers.",
    "options": {
        // See available versions at https://github.com/pnpm/pnpm/releases
        "target_version": {
            "type": "string",
            "proposals": ["10.12.1", "10.11.0", "9.15.9"],
            "default": "10.12.1",
            "description": "Select a supported pnpm version"
        },
        "target_checksum": {
            "type": "string",
            "proposals": [],
            "default": "",
            "description": "SHA256 checksum for the pnpm binary"
        }
    },
    "containerEnv": {
        "PATH": "/home/dev/.local/share/pnpm:/home/dev/.local/bin:${PATH}",
        "PNPM_HOME": "/home/dev/.local/share/pnpm"
    },
    "installsAfter": [
        "./nodejs"
    ],
    "dependsOn": {
        "./bootstrap": {}
    }
}
