// egress-filter-feature/devcontainer-feature.json
// See https://containers.dev/implementors/features/ for the Development Container Feature specification.
{
    "name": "egress-filter-feature",
    "id": "egress-filter",
    "version": "1.2.0",
    "description": "Domain-based egress filtering using Squid proxy and iptables for Red Hat UBI DevContainers.",
    "options": {
        "allowed_domains": {
            "type": "string",
            "default": "example.com",
            "description": "Comma-separated list of allowed domains. Prefix with '.' for subdomain matching (e.g., '.example.com')."
        },
        "squid_port": {
            "type": "string",
            "default": "3128",
            "description": "Localhost port for the Squid proxy."
        }
    },
    "containerEnv": {
        "http_proxy": "http://localhost:3128",
        "https_proxy": "http://localhost:3128",
        "HTTP_PROXY": "http://localhost:3128",
        "HTTPS_PROXY": "http://localhost:3128",
        "no_proxy": "localhost,127.0.0.1",
        "NO_PROXY": "localhost,127.0.0.1"
    },
    "capAdd": [
        "NET_ADMIN",
        "NET_RAW"
    ],
    "postStartCommand": "/usr/local/bin/egress-filter-start.sh",
    "installsAfter": [],
    "dependsOn": {
        "./bootstrap": {}
    }
}
