// dotnet-feature/devcontainer-feature.json
// See https://containers.dev/implementors/features/ for the Development Container Feature specification.
{
    "name": "dotnet-feature",
    "id": "dotnet",
    "version": "1.0.0",
    "description": "Installs Microsoft .NET SDK on Red Hat UBI DevContainers.",
    "options": {
        // See available versions at https://dotnet.microsoft.com/download/dotnet
        "target_version": {
            "type": "string",
            "proposals": ["8.0.418", "9.0.203"],
            "default": "8.0.418",
            "description": "Select a supported .NET SDK version"
        },
        "target_checksum": {
            "type": "string",
            "proposals": [],
            "default": "",
            "description": "SHA256 checksum for the .NET SDK tarball"
        }
    },
    "containerEnv": {
        "DOTNET_ROOT": "/home/dev/.local/share/dotnet",
        "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
        "PATH": "/home/dev/.local/share/dotnet:/home/dev/.local/bin:${PATH}"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-dotnettools.csdevkit"
            ]
        }
    },
    "installsAfter": []
}
