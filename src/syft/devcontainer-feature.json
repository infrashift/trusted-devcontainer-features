// syft-feature/devcontainer-feature.json
// See https://containers.dev/implementors/features/ for the Development Container Feature specification.
{
    "name": "syft-feature",
    "id": "syft",
    "version": "1.2.0",
    "description": "Installs Anchore Syft SBOM generator on Red Hat UBI DevContainers.",
    "options": {
        // See available versions at https://github.com/anchore/syft/releases
        "target_version": {
            "type": "string",
            "proposals": ["1.42.0", "1.41.0"],
            "default": "1.42.0",
            "description": "Select a supported Syft binary version"
        },
        "target_checksum": {
            "type": "string",
            "proposals": [],
            "default": "",
            "description": "SHA256 checksum for the Syft binary (leave empty to download checksums file)"
        }
    },
    "containerEnv": {
        "PATH": "/home/dev/.local/bin:${PATH}"
    },
    "installsAfter": [],
    "dependsOn": {
        "./bootstrap": {}
    }
}
