// sqlcmd-feature/devcontainer-feature.json
// See https://containers.dev/implementors/features/ for the Development Container Feature specification.
{
    "name": "sqlcmd-feature",
    "id": "sqlcmd",
    "version": "1.0.0",
    "description": "Installs Microsoft sqlcmd (go-sqlcmd) for SQL Server and Azure SQL on Red Hat UBI DevContainers.",
    "options": {
        // go-sqlcmd release versions, without the v prefix.
        // See https://github.com/microsoft/go-sqlcmd/releases
        "target_version": {
            "type": "string",
            "proposals": [],
            "default": "1.10.0",
            "description": "Select a supported go-sqlcmd version"
        },
        "target_checksum": {
            "type": "string",
            "proposals": [],
            "default": "",
            "description": "SHA256 checksum for the go-sqlcmd release tarball"
        }
    },
    "installsAfter": [],
    "dependsOn": {
        "./bootstrap": {}
    }
}
