// gradle-feature/devcontainer-feature.json
// See https://containers.dev/implementors/features/ for the Development Container Feature specification.
//
// THIS FILE IS THE SINGLE SOURCE OF TRUTH FOR EVERY OPTION DEFAULT.
{
    "name": "gradle-feature",
    "id": "gradle",
    "version": "1.1.0",
    "description": "Installs the Gradle build tool on Red Hat UBI DevContainers.",
    "options": {
        // See available versions at https://gradle.org/releases/
        "target_version": {
            "type": "string",
            "proposals": ["9.7.1", "8.14.5"],
            "default": "9.7.1",
            "description": "Select a supported Gradle version"
        },
        // Found at https://services.gradle.org/distributions/gradle-<version>-bin.zip.sha256
        "target_checksum": {
            "type": "string",
            "proposals": [],
            "default": "",
            "description": "SHA256 of gradle-<version>-bin.zip. Required only when target_version is not pinned in the role's _gradle_pinned_checksums map."
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "vscjava.vscode-gradle"
            ]
        }
    },
    "installsAfter": ["./openjdk"],
    "dependsOn": {
        "./bootstrap": {}
    }
}
