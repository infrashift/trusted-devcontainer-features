// cuelang-feature/devcontainer-feature.json
// See https://containers.dev/implementors/features/ for the Development Container Feature specification.
{
    "name": "cuelang-feature",
    "id": "cuelang",
    "version": "1.2.1",
    "description": "Installs CUElang on Red Hat UBI DevContainers.",
    "options": {
        // See available versions at https://github.com/cue-lang/cue/releases
        // Targeting cue_v{{ target_version }}_linux_amd64.tar.gz
        "target_version": {
            "type": "string",
            "proposals": ["0.15.4", "0.14.1"],
            "default": "0.15.4",
            "description": "Select a supported CUElang binary version"
        },
        "target_checksum": {
            "type": "string",
            "default": "",
            "description": "SHA256 of the release tarball. Required when target_version is not the default."
        }
    },
    "containerEnv": {
        "PATH": "/home/dev/.local/bin:${PATH}"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "jallen7usa.vscode-cue-fmt"
            ]
        }
    },
    "installsAfter": [
        "./golang"
    ],
    "dependsOn": {
        "./bootstrap": {}
    }
}
