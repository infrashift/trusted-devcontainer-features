// redis-cli-feature/devcontainer-feature.json
// See https://containers.dev/implementors/features/ for the Development Container Feature specification.
{
    "name": "redis-cli-feature",
    "id": "redis-cli",
    "version": "1.0.0",
    "description": "Installs redis-cli (the Redis-protocol-compatible Valkey CLI) on Red Hat UBI DevContainers.",
    "options": {
        // Valkey release versions. See https://valkey.io/download/
        "target_version": {
            "type": "string",
            "proposals": [],
            "default": "9.1.3",
            "description": "Select a supported Valkey CLI version"
        },
        "target_checksum": {
            "type": "string",
            "proposals": [],
            "default": "",
            "description": "SHA256 checksum for the Valkey release tarball"
        }
    },
    "installsAfter": [],
    "dependsOn": {
        "./bootstrap": {}
    }
}
