// grype-feature/devcontainer-feature.json
// See https://containers.dev/implementors/features/ for the Development Container Feature specification.
{
    "name": "grype-feature",
    "id": "grype",
    "version": "1.2.0",
    "description": "Installs Anchore Grype vulnerability scanner on Red Hat UBI DevContainers.",
    "options": {
        // See available versions at https://github.com/anchore/grype/releases
        "target_version": {
            "type": "string",
            "proposals": ["0.108.0", "0.107.0"],
            "default": "0.108.0",
            "description": "Select a supported Grype binary version"
        },
        "target_checksum": {
            "type": "string",
            "proposals": [],
            "default": "",
            "description": "SHA256 checksum for the Grype binary (leave empty to download checksums file)"
        }
    },
    "containerEnv": {
        "PATH": "/home/dev/.local/bin:${PATH}"
    },
    "installsAfter": [],
    "dependsOn": {
        "./bootstrap": {}
    }
}
