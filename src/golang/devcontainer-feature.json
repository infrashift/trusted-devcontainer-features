// golang-feature/devcontainer-feature.json
// See https://containers.dev/implementors/features/ for the Development Container Feature specification.
{
    "name": "golang-feature",
    "id": "golang",
    "version": "1.2.1",
    "description": "Installs Go (Golang) on Red Hat UBI DevContainers.",
    "options": {
        // See available versions at https://go.dev/dl/
        // Targeting go{{ target_version }}.linux-amd64.tar.gz
        "target_version": {
            "type": "string",
            "proposals": ["1.26.0", "1.24.4", "1.23.10"],
            "default": "1.26.0",
            "description": "Select a supported Golang binary version"
        },
        // See checksums at https://go.dev/dl/
        "target_checksum": {
            "type": "string",
            "default": "",
            "description": "SHA256 of the release tarball. Required only when target_version is not pinned in the role's _go_pinned_checksums map."
        }
    },
    "containerEnv": {
        "PATH": "/home/dev/.local/share/go/bin:/home/dev/.local/bin:${PATH}",
        "GOPATH": "/home/dev/.local/share/gopath"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "golang.Go"
            ]
        }
    },
    "installsAfter": [],
    "dependsOn": {
        "./bootstrap": {}
    }
}
