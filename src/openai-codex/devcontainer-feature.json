// openai-codex-feature/devcontainer-feature.json
// See https://containers.dev/implementors/features/ for the Development Container Feature specification.
{
    "name": "openai-codex-feature",
    "id": "openai-codex",
    "version": "1.0.1",
    "description": "Installs OpenAI Codex CLI on Red Hat UBI DevContainers.",
    "options": {
        // See available versions at https://www.npmjs.com/package/@openai/codex?activeTab=versions
        "target_version": {
            "type": "string",
            "proposals": ["latest"],
            "default": "latest",
            "description": "Select the OpenAI Codex version to install"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "openai.chatgpt"
            ]
        }
    },
    "containerEnv": {
        "PATH": "/home/dev/.bun/bin:${PATH}"
    },
    "installsAfter": [
        "./bun",
        "./nodejs"
    ]
}
