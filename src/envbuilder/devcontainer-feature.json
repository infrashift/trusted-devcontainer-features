// envbuilder-feature/devcontainer-feature.json
// Find Development Container Feature Specification at https://containers.dev/implementors/features/
//
// THIS FILE IS THE SINGLE SOURCE OF TRUTH FOR EVERY OPTION DEFAULT.
//
// target_checksum is an OCI layer blob digest, not a release-tarball hash.
// envbuilder publishes no release binaries, so the binary is fetched as the
// single image layer that contains it. A blob is addressed by the sha256 of its
// own bytes, which is why the digest is both the URL and the checksum.
{
    "name": "envbuilder-feature",
    "id": "envbuilder",
    "version": "1.1.0",
    "description": "Installs Coder envbuilder, which builds development environments from repositories in a container, on Red Hat UBI DevContainers.",
    "options": {
        "target_version": {
            "type": "string",
            "proposals": ["1.3.0"],
            "default": "1.3.0",
            "description": "Select a supported envbuilder version"
        },
        "target_checksum": {
            "type": "string",
            "proposals": [],
            "default": "",
            "description": "SHA256 of the OCI layer holding .envbuilder/bin/envbuilder. Required when target_version is not pinned in the role's _envbuilder_pinned_layers map."
        }
    },
    "installsAfter": [],
    "dependsOn": {
        "./bootstrap": {}
    }
}
