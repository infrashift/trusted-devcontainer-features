// claude-code-feature/devcontainer-feature.json
// See https://containers.dev/implementors/features/ for the Development Container Feature specification.
{
    "name": "claude-code-feature",
    "id": "claude-code",
    "version": "1.2.0",
    "description": "Installs Claude Code (Anthropic's AI coding assistant CLI) on Red Hat UBI DevContainers.",
    "options": {
        // See available versions at https://www.npmjs.com/package/@anthropic-ai/claude-code?activeTab=versions
        "target_version": {
            "type": "string",
            "proposals": ["latest"],
            "default": "latest",
            "description": "Select the Claude Code version to install"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "anthropics.claude-code"
            ]
        }
    },
    "containerEnv": {
        "PATH": "/home/dev/.bun/bin:${PATH}"
    },
    "installsAfter": [
        "./bun",
        "./nodejs"
    ],
    "dependsOn": {
        "./bootstrap": {}
    }
}
