node_modules/
*.log

# Feature trees copied into the templates by `make test-template` and by CI's
# "Prepare test template" step. Regenerated on every run; `make clean` removes them.
test-templates/*/.devcontainer/*/
test-templates/*/.devcontainer/devcontainer-lock.json
test-templates/*/test-lib.sh

# Features staged into .devcontainer/ by scripts/prepare-devcontainer.sh so the
# maintainer environment can build from the working tree. SKELETON-feature is
# tracked source, not a staged copy.
.devcontainer/*/
!.devcontainer/SKELETON-feature/
.devcontainer/devcontainer-lock.json
