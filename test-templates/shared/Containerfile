FROM ghcr.io/infrashift/trusted-base-images/trusted/fedora43-minimal@sha256:1ed67eb14da57087e206e45bba67a84264e213e8c545d64a9683fbc38bca3a65

USER root

# Base package baseline.
#
# Feature prerequisites — the devcontainer feature mechanism cannot work without these:
#   tar, gzip        ansible.builtin.unarchive and every tool-tarball download
#   curl             binary downloads (--allowerasing swaps curl-minimal for full curl)
#   util-linux       runuser, used to drop from root to the target user
#                    (util-linux-core does NOT ship su/runuser on Fedora)
#
# Interactive-use baseline — fedora43-minimal ships none of these:
#   procps-ng, diffutils, findutils, less, which, fzf
#
# Shared runtime libraries. These are linked against by userland tools installed
# by features (bun needs unzip; the .NET SDK and OpenJDK need libicu and
# openssl-libs). Keeping them here rather than in each feature means those
# features stay entirely userland and never need the privileged lane.
RUN dnf5 -y install --allowerasing --setopt=install_weak_deps=False \
        tar \
        gzip \
        curl \
        util-linux \
        unzip \
        libicu \
        openssl-libs \
        procps-ng \
        diffutils \
        findutils \
        less \
        which \
        fzf \
    && dnf5 clean all \
    && rm -rf /var/cache/dnf

# Create the devcontainer user.
#
# PARAMETERISED SO A TEMPLATE CAN REPRODUCE A REAL SEED'S ACCOUNT. The default
# below -- dev, 1001:1001 -- is this repository's own convention and is NOT what
# the trusted seeds use: they run as `user', uid 1001, GID 0, because the
# platform's host volume is chowned to 1001:0 and its jobspec assumes it.
#
# That difference is not cosmetic, and it hid a real bug. Fifteen features write
# a literal /home/dev into containerEnv; under the default account those paths
# are correct, so a feature that depends on containerEnv passes here and fails in
# a workspace, where the home directory is /home/user AND sshd strips the
# environment before a login shell rebuilds it. sqlpackage 1.0.0 shipped exactly
# that way: green in this repository, unable to run anywhere else.
#
# A template that names USERNAME=user USER_GID=0 therefore tests the contract
# the seeds actually have. See test-templates/dotnet-node.
ARG USERNAME=dev
ARG USER_UID=1001
ARG USER_GID=1001

# GID 0 is root's group and already exists, so it must not be created -- and a
# group named after the user is still needed whatever the primary GID is: the
# shared runner drops privileges with `setpriv --regid=$_REMOTE_USER', which
# looks the GROUP up by the USER's name. The trusted seeds hit this exactly
# once, when the first userland feature died on
# `setpriv: failed to parse regid: 'user''.
RUN if [ "${USER_GID}" != "0" ]; then groupadd --gid ${USER_GID} ${USERNAME}; fi \
    && useradd -m -s /bin/bash --uid ${USER_UID} --gid ${USER_GID} ${USERNAME} \
    && if ! getent group ${USERNAME} >/dev/null 2>&1; then groupadd -g ${USER_UID} ${USERNAME}; fi

# uv and the pinned Ansible bootstrap environment (/opt/bootstrap) are provided
# by the 'bootstrap' devcontainer feature, which every other feature dependsOn.
# They are deliberately not baked in here: pinning and checksum verification
# live with the feature that owns them.

USER ${USERNAME}

ENV HOME=/home/${USERNAME}

# THE TOOLCHAIN DIRECTORIES, resolved from USERNAME rather than hardcoded.
# Features install under $HOME/.local/share/<tool> and announce the path through
# containerEnv -- which every one of them writes as a literal /home/dev. That is
# correct for the default account and wrong for any other, so a template that
# names a different USERNAME would not find dotnet, node or pnpm at all. Adding
# them here mirrors what a real seed does in /etc/profile.d, and keeps the
# template testing the FEATURES rather than that one hardcoded string.
#
# AND THE FEATURES CANNOT FIX THIS THEMSELVES -- TESTED, 2026-09-16. The obvious
# repair is to write ${containerEnv:HOME} instead of /home/dev in each feature's
# containerEnv. It does not work: the devcontainer CLI emits containerEnv
# straight into a Dockerfile ENV, where Docker's own substitution reads the
# value and rejects it --
#
#   failed to process "${containerEnv:HOME}/.local/share/dotnet":
#   unsupported modifier (:H) in substitution
#
# -- so the build fails outright rather than resolving. containerEnv values are
# literals, with no substitution available at that point, and a feature has no
# way to know the account it will be installed for. Compensating HERE, as a seed
# compensates in /etc/profile.d, is the available answer rather than a shortcut
# past a better one.
#
# DOTNET_ROOT IS DELIBERATELY NOT SET HERE. A .NET apphost finds its runtime
# through that variable, and under a non-default USERNAME the dotnet feature's
# containerEnv points it at an account that does not exist. Leaving it wrong is
# the point: a tool that depends on the environment being right fails here,
# which is how sqlpackage 1.0.0 should have been caught. A tool that carries its
# own runtime location passes.
ENV PATH="/home/${USERNAME}/.local/bin:/home/${USERNAME}/.local/share/dotnet:/home/${USERNAME}/.local/share/nodejs/bin:/home/${USERNAME}/.local/share/pnpm:${PATH}"

RUN mkdir -p ${HOME}/.local/bin \
    && echo 'export PATH="${HOME}/.local/bin:${PATH}"' >> ${HOME}/.bashrc \
    && echo 'export PATH="${HOME}/.local/bin:${PATH}"' >> ${HOME}/.bash_profile

CMD ["sleep", "infinity"]
