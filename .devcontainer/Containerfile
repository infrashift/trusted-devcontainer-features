FROM registry.access.redhat.com/ubi9/ubi:latest

USER root

# Silence subscription messages and update base packages
RUN echo "enabled=0" >> /etc/yum/pluginconf.d/subscription-manager.conf \
 && dnf update --disablerepo=* --enablerepo=ubi-9-appstream-rpms --enablerepo=ubi-9-baseos-rpms -y && rm -rf /var/cache/yum

# Create the DevContainer user; default to 'vscode 1000:1000'
ENV DEVCONTAINER_USERNAME=${DEVCONTAINER_USERNAME:-vscode}
ENV DEVCONTAINER_USER_UID=${DEVCONTAINER_USER_UID:-1000}
ENV DEVCONTAINER_USER_GID=${DEVCONTAINER_USER_GID:-$DEVCONTAINER_USER_UID}

RUN groupadd --gid $DEVCONTAINER_USER_GID $DEVCONTAINER_USERNAME \
    && useradd -m -s /bin/bash --uid $DEVCONTAINER_USER_UID --gid $DEVCONTAINER_USER_GID $DEVCONTAINER_USERNAME

USER $DEVCONTAINER_USERNAME

ENV DEVCONTAINER_USER_HOME=${DEVCONTAINER_USER_HOME:-/home/$DEVCONTAINER_USERNAME}
ENV DEVCONTAINER_USER_LOCAL_BIN_PATH=${DEVCONTAINER_USER_HOME}/.local/bin

# Add ~/.local/bin to PATH for the devcontainer user
RUN export PATH="${DEVCONTAINER_USER_LOCAL_BIN_PATH}:$PATH" \
 && echo 'export PATH="${DEVCONTAINER_USER_LOCAL_BIN_PATH}:$PATH"' | tee -a ${DEVCONTAINER_USER_HOME}/.bashrc > /dev/null \
 && echo 'export PATH="${DEVCONTAINER_USER_LOCAL_BIN_PATH}:$PATH"' | tee -a ${DEVCONTAINER_USER_HOME}/.bash_profile > /dev/null

USER root

# Install uv for feature bootstrap (ansible-playbook execution via 'uv run --with ansible-core')
RUN curl -LsSf https://astral.sh/uv/install.sh | env INSTALLER_NO_MODIFY_PATH=1 UV_INSTALL_DIR=/usr/local/bin sh \
 && uv --version

USER $DEVCONTAINER_USERNAME

ENTRYPOINT ["$@"]
CMD ["sleep", "infinity"]
