// yq-feature/devcontainer-feature.json
// See https://containers.dev/implementors/features/ for the Development Container Feature specification.
{
    "name": "yq-feature",
    "id": "yq",
    "version": "1.0.0",
    "description": "Installs yq YAML/JSON/XML processor on Red Hat UBI DevContainers.",
    "options": {
        // See available versions at https://github.com/mikefarah/yq/releases
        "target_version": {
            "type": "string",
            "proposals": ["4.45.4", "4.44.6"],
            "default": "4.45.4",
            "description": "Select a supported yq version"
        },
        "target_checksum": {
            "type": "string",
            "proposals": [],
            "default": "",
            "description": "SHA256 checksum for the yq binary (leave empty to download checksums file)"
        }
    },
    "containerEnv": {
        "PATH": "${containerUserHome}/.local/bin:${localEnv:PATH}"
    },
    "installsAfter": []
}
