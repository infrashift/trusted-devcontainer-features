{
    "build": {
        "dockerfile": "./Containerfile",
        "context": "."
    },
    // Uncomment for use with rootless podman
    // "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,Z,consistency=cached",
    // Comment out when using rootless podman
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
    "workspaceFolder": "/workspace",
    "customizations": {
        "vscode": {
            "settings": {
                "json.schemas": [
                    {
                        "fileMatch": [
                            "*/devcontainer-feature.json"
                        ],
                        "url": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainerFeature.schema.json"
                    }
                ],
                "terminal.integrated.defaultProfile.linux": "bash"
            },
            "extensions": [
                "usernamehw.indent-one-space",
                "DavidAnson.vscode-markdownlint",
                "bierner.github-markdown-preview"
            ]
        }
    },
    "features": {
        "./git-feature": {},
        "./git-lfs-feature": {},
        "./golang-feature": {},
        "./cuelang-feature": {},
        "./jq-feature": {},
        "./yq-feature": {},
        "./uv-ruff-feature": {},
        "./grype-feature": {},
        "./syft-feature": {},
        "./nodejs-feature": {},
        "./npm-feature": {},
        "./pnpm-feature": {},
        "./bun-feature": {},
        "./python-feature": {"target_version": "3.12"},
        "./ansible-core-feature": {"target_version": "2.18.2", "target_python_version": "3.12"}
        // "./openjdk-feature": {},
        // "./dotnet-feature": {}
    },
    "runArgs": [
        // Uncomment for rootless podman
        // "--userns=keep-id"
    ],
    "containerUser": "vscode",
    "updateRemoteUserUID": true
}