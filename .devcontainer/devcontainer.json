{
    // Features must live under .devcontainer/ for the CLI to resolve them, so
    // stage them there first. initializeCommand runs on the host before feature
    // resolution. The staged copies are gitignored.
    "initializeCommand": "bash \"${localWorkspaceFolder}/scripts/prepare-devcontainer.sh\"",
    "build": {
        "dockerfile": "./Containerfile",
        // The Containerfile COPYs nothing, so the context only needs to be this
        // directory. ".." shipped the whole repo -- ~250MB of docs/node_modules
        // -- to the daemon on every build.
        "context": "."
    },
    // Uncomment for use with rootless podman
    //"workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,Z,consistency=cached",
    // Comment out when using rootless podman
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
    "workspaceFolder": "/workspace",
    "customizations": {
        "vscode": {
            "settings": {
                "json.schemas": [
                    {
                        "fileMatch": [
                            "*/devcontainer-feature.json"
                        ],
                        "url": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainerFeature.schema.json"
                    }
                ],
                "terminal.integrated.defaultProfile.linux": "bash"
            },
            "extensions": [
                "usernamehw.indent-one-space",
                "DavidAnson.vscode-markdownlint",
                "bierner.github-markdown-preview"
            ]
        }
    },
    "features": {
        "./bootstrap": {},
        "./git": {},
        "./git-lfs": {},
        "./golang": {},
        "./cuelang": {},
        "./jq": {},
        "./yq": {},
        "./uv-ruff": {},
        "./grype": {},
        "./syft": {},
        "./nodejs": {},
        "./npm": {},
        "./claude-code": {},
        "./openai-codex": {},
        "./pnpm": {},
        "./bun": {},
        "./python": {"target_version": "3.12"},
        "./ansible-core": {"target_version": "2.18.2", "target_python_version": "3.12"},
        "./openjdk": {},
        "./dotnet": {}
    },
    "runArgs": [
        // Uncomment for rootless podman
        // "--userns=keep-id"
    ],
    "containerUser": "dev",
    "updateRemoteUserUID": false
}