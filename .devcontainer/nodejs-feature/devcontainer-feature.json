// nodejs-feature/devcontainer-feature.json
// See https://containers.dev/implementors/features/ for the Development Container Feature specification.
{
    "name": "nodejs-feature",
    "id": "nodejs",
    "version": "1.0.0",
    "description": "Installs Node.js on Red Hat UBI DevContainers.",
    "options": {
        // See available versions at https://nodejs.org/en/download/
        "target_version": {
            "type": "string",
            "proposals": ["22.16.0", "20.19.1"],
            "default": "22.16.0",
            "description": "Select a supported Node.js version"
        },
        "target_checksum": {
            "type": "string",
            "proposals": [],
            "default": "",
            "description": "SHA256 checksum for the Node.js tarball"
        }
    },
    "containerEnv": {
        "PATH": "${containerUserHome}/.local/share/nodejs/bin:${containerUserHome}/.local/bin:${localEnv:PATH}"
    },
    "installsAfter": []
}
